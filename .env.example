PORT=4000

# Required for POST/PUT/DELETE. Send it as the x-admin-api-key header.
ADMIN_API_KEY=replace-with-a-long-random-secret

# Comma-separated list of browser origins allowed by CORS (the blog's public origin).
# Server-side requests from Next.js send no Origin header and are always allowed.
ALLOWED_ORIGINS=http://localhost:3001

# Markdown posts directory. Defaults to ./content/posts in this project.
# POSTS_DIR=./content/posts

# Author shown on posts whose frontmatter has no `author` field.
DEFAULT_AUTHOR_NAME=Alex Morgan

# On-demand revalidation webhook on the blog (called after create/update/delete).
# Under a Multi-Zones basePath this becomes e.g. https://example.com/blog/api/revalidate
REVALIDATE_URL=http://localhost:3001/api/revalidate
# Must equal REVALIDATE_SECRET in the blog's .env.local.
REVALIDATE_SECRET=replace-with-another-long-random-secret
# REVALIDATE_TIMEOUT_MS=5000

# Rate limit for write endpoints, per client IP.
# WRITE_RATE_LIMIT_WINDOW_MS=900000
# WRITE_RATE_LIMIT_MAX=30

# Set when running behind a reverse proxy (e.g. 1 for one hop) so rate limiting sees real client IPs.
# TRUST_PROXY=1
